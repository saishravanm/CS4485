import { LexRuntimeV2Client, RecognizeTextCommand } from "@aws-sdk/client-lex-runtime-v2";
import { fromCognitoIdentityPool } from "@aws-sdk/credential-provider-cognito-identity";

const REGION = import.meta.env.VITE_LEX_REGION as string;
const IDENTITY_POOL_ID = import.meta.env.VITE_COGNITO_ID_POOL_ID as string;

export const lexClient = new LexRuntimeV2Client({
  region: REGION,
  credentials: fromCognitoIdentityPool({
    clientConfig: { region: REGION },
    identityPoolId: IDENTITY_POOL_ID
  })
});

export async function talkToLex(opts: {
  botId: string;
  botAliasId: string;
  localeId: string;
  sessionId: string;  // stable per tab/user
  text: string;
}) {
  return lexClient.send(new RecognizeTextCommand(opts));
}
